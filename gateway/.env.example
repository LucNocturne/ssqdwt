# 网关监听端口
PORT=8787

# SQLite 文件路径(相对项目根)
DB_PATH=./data/gateway.db

# **必填** API key 哈希用 pepper(>= 32 chars)。生成:openssl rand -hex 32
KEY_HASH_SECRET=

# 上游模式:mock | cpa
UPSTREAM_MODE=mock

# CPA 反代地址(UPSTREAM_MODE=cpa 时生效)
CPA_BASE_URL=http://127.0.0.1:8004
CPA_API_KEY=

# 上游请求超时(ms)
UPSTREAM_TIMEOUT_MS=120000

# 上游响应体最大字节(防 OOM)
UPSTREAM_MAX_RESPONSE_BYTES=52428800

# **必填** 管理接口口令(>= 16 chars,不能是 'change-me-please')
ADMIN_TOKEN=

# 默认新建 key 的初始 credits(seed 脚本用)
DEFAULT_INITIAL_CREDITS=1000
